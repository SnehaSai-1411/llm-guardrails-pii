# llm-guardrails-pii — no API keys are needed to run this project.
# All guardrails run locally (Presidio/spaCy, regex patterns, token overlap).
# Copy to .env only if you want to override the defaults below.

# Optional path to a YAML file overriding guardrail defaults
# (see guardrails/config.py for the supported keys).
# GUARDRAIL_CONFIG=./guardrail-config.yaml

# Force the regex PII recognizer instead of Presidio (useful for
# lightweight environments or CI without the spaCy model):
# GUARDRAIL_PII_BACKEND=regex
# Values: auto (default), presidio, regex
